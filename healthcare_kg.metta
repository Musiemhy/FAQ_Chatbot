; Stored in the form of (Name Sympotms Causes)
((Diabetes Type 2) (Increased thirst, Frequent urination, Fatigue, Blurred vision) (Insulin resistance, Obesity, Genetics))
(Hypertension (Headache, Dizziness, Shortness of breath, Nosebleeds) (High salt intake, Obesity, Genetics, Stress))
(Influenza (Fever, Cough, Sore throat, Fatigue, Runny nose) (Influenza virus))
(Covid-19 (Fever, Cough, Loss of taste, Loss of smell, Shortness of breath) (SARS-CoV-2 virus))
(Pneumonia (Chest pain, Cough with phlegm, Fever, Difficulty breathing) (Bacterial infection, Viral infection))
(Asthma (Wheezing, Shortness of breath, Chest tightness, Coughing) (Allergies, Genetic predisposition, Pollution))
(Tuberculosis (Chronic cough, Night sweats, Weight loss, Fatigue) (Mycobacterium tuberculosis))
(Bronchitis (Cough with mucus, Fatigue, Shortness of breath) (Viral infection, Smoking))
((Chronic Sinusitis) (Facial pain, Nasal congestion, Headache) (Allergies, Nasal polyps, Bacterial infection))
(Copd (Chronic cough, Shortness of breath, Wheezing, Chest tightness) (Smoking, Air pollution, Genetic factors))
((Heart Disease) (Chest pain, Shortness of breath, Fatigue) (High cholesterol, Smoking, Hypertension))
(Stroke (Sudden numbness, Confusion, Trouble speaking, Dizziness) (High blood pressure, Atherosclerosis, Blood clots))
(Alzheimers (Memory loss, Confusion, Difficulty reasoning) (Age, Genetics, Plaques in brain))
(Parkinsons (Tremors, Stiffness, Slow movement, Balance issues) (Dopamine-producing neuron degeneration))
(Epilepsy (Seizures, Uncontrollable movements, Loss of awareness) (Brain injury, Genetics, Neurological disorder))
(Migraine (Severe headache, Nausea, Sensitivity to light, Sensitivity to sound) (Hormonal changes, Stress, Bright lights))
(Depression (Persistent sadness, Fatigue, Loss of interest, Sleep disturbances) (Genetics, Chemical imbalances, Life events))
((Anxiety Disorder) (Excessive worry, Rapid heartbeat, Restlessness) (Stress, Genetics, Trauma))
((Bipolar Disorder) (Mood swings, High energy episodes, Depressive episodes) (Genetics, Brain chemistry imbalances))
(Schizophrenia (Hallucinations, Delusions, Disorganized thinking) (Genetics, Dopamine imbalance, Environmental triggers))
(Gerd (Heartburn, Acid reflux, Difficulty swallowing) (Weak lower esophageal sphincter, Obesity, Spicy food))
((Peptic Ulcer) (Stomach pain, Bloating, Nausea, Vomiting) (H. pylori infection, NSAIDs overuse, Smoking))
((Celiac Disease) (Diarrhea, Weight loss, Fatigue, Bloating) (Autoimmune reaction to gluten))
((Crohns Disease) (Abdominal pain, Diarrhea, Fatigue, Weight loss) (Immune system dysfunction, Genetics, Gut bacteria imbalance))
((Ulcerative Colitis) (Rectal bleeding, Diarrhea, Abdominal cramps, Urgency to defecate) (Immune system overreaction))
((Irritable Bowel Syndrome) (Abdominal pain, Bloating, Constipation, Diarrhea) (Stress, Poor diet, Gut bacteria imbalance))
(Appendicitis (Severe lower right abdominal pain, Nausea, Fever) (Blockage of appendix))
((Hepatitis B) (Jaundice, Fatigue, Abdominal pain, Dark urine) (Hepatitis B virus))
((Kidney Stones) (Severe back pain, Blood in urine, Frequent urination) (Dehydration, High oxalate diet, Genetics))
((Chronic Kidney Disease) (Swelling, Fatigue, High blood pressure, Loss of appetite) (Diabetes, Hypertension, Infections))
((Urinary Tract Infection) (Painful urination, Frequent urge to urinate, Cloudy urine) (Bacterial infection, E. coli))
(Anemia (Fatigue, Pale skin, Shortness of breath) (Iron deficiency, Vitamin B12 deficiency, Chronic disease))
((Hypothyroidism) (Fatigue, Weight gain, Depression, Slow heart rate) (Iodine deficiency, Autoimmune disorders, Hashimotos))
((Hyperthyroidism) (Weight loss, Rapid heartbeat, Anxiety, Tremors) (Overactive thyroid, Graves disease))
((Rheumatoid Arthritis) (Joint pain, Swelling, Stiffness, Fatigue) (Autoimmune response))
((Osteoarthritis) (Joint pain, Stiffness, Decreased flexibility) (Aging, Joint wear and tear))
(Gout (Sudden joint pain, Swelling, Redness) (High uric acid, Diet rich in purines, Alcohol consumption))
(Lupus (Fatigue, Joint pain, Skin rashes, Sensitivity to sunlight) (Autoimmune response))
(Psoriasis (Red scaly skin patches, Itching, Joint pain) (Autoimmune response, Genetics))
(Chickenpox (Itchy rash, Blisters, Fever) (Varicella-zoster virus))
(Measles (Rash, Fever, Cough, Conjunctivitis) (Measles virus))
(Mumps (Swollen salivary glands, Fever, Headache) (Mumps virus))
(Rubella (Rash, Fever, Swollen lymph nodes) (Rubella virus))
((Dengue Fever) (High fever, Severe muscle pain, Rash) (Dengue virus, Mosquito bites))
(Malaria (Fever, Chills, Sweating, Headache) (Plasmodium parasite, Mosquito bites))
(Leprosy (Skin lesions, Nerve damage, Muscle weakness) (Mycobacterium leprae))
((Typhoid Fever) (Fever, Abdominal pain, Weakness, Loss of appetite) (Salmonella Typhi))
(Tetanus (Muscle stiffness, Jaw lock, Difficulty swallowing) (Clostridium tetani))
(Cholera (Severe diarrhea, Dehydration, Vomiting) (Vibrio cholerae))
(Rabies (Fever, Confusion, Hydrophobia, Aggression) (Rabies virus, Animal bite))
(Hiv/Aids (Weight loss, Fatigue, Recurrent infections, Swollen lymph nodes) (HIV virus))

; Stored in the form of (Name Uses SideEffects Dosage)
(Metformin (Diabetes management) (Nausea, Diarrhea, Stomach pain) 500mg-2000mg/day)
(Insulin (Diabetes management) (Hypoglycemia, Weight gain) (Varies by patient))
(Lisinopril (Hypertension, Heart disease) (Dizziness, Cough, Kidney issues) 10mg-40mg/day)
(Amlodipine (Hypertension, Angina) (Swelling, Fatigue, Dizziness) 5-10mg/day)
(Oseltamivir Influenza (Nausea, Vomiting) (75mg twice daily))
(Remdesivir COVID-19 (Liver enzyme elevations, Nausea) (200mg on day 1, then 100mg daily))
(Azithromycin (Pneumonia, Bacterial infections) (Stomach pain, Diarrhea) 500mg/day)
(Albuterol Asthma (Tremors, Rapid heartbeat, Anxiety) (2 puffs inhaler as needed))
(Isoniazid Tuberculosis (Liver toxicity, Numbness) 300mg/day)
(Dextromethorphan Bronchitis (Drowsiness, Dizziness) (10-30mg every 4-6 hours))
(Fluticasone (Chronic Sinusitis, Inflammation) (Nosebleeds, Sore throat) (1-2 sprays per nostril daily))
(Tiotropium COPD (Dry mouth, Constipation) (18mcg once daily))
(Atorvastatin (Heart Disease, Cholesterol management) (Muscle pain, Elevated liver enzymes) 10-80mg/day)
(Warfarin (Stroke prevention, Blood clots) (Bleeding risk, Dizziness) 2-10mg/day)
(Donepezil Alzheimers (Nausea, Insomnia) 5-10mg/day)
(Levodopa Parkinsons (Nausea, Dizziness, Dyskinesia) 300-800mg/day)
(Valproate Epilepsy (Weight gain, Hair loss) 500-2000mg/day)
(Sumatriptan Migraine (Tingling, Dizziness) (25-100mg as needed))
(Sertraline (Depression, Anxiety) (Insomnia, Nausea) 50-200mg/day)
(Alprazolam Anxiety (Drowsiness, Dependence) (0.25-0.5mg as needed))
(Lithium (Bipolar Disorder) (Tremor, Increased thirst) 600-1200mg/day)
(Risperidone (Schizophrenia, Bipolar Disorder) (Weight gain, Drowsiness) 1-6mg/day)
(Omeprazole (GERD, Acid reflux) (Stomach pain, Diarrhea) 20mg/day)
(Ranitidine (Peptic Ulcer, Acid reflux) (Headache, Constipation) (150mg twice daily))
(Prednisone (Inflammation, Autoimmune disorders) (Weight gain, Mood changes) 5-60mg/day)
(Infliximab (Crohns Disease, Ulcerative Colitis) (Infection risk, Infusion reactions) (5mg/kg every 8 weeks))
(Mesalamine (Ulcerative Colitis) (Headache, Nausea) (800-1200mg three times daily))
((Peppermint oil) (Irritable Bowel Syndrome) (Heartburn, Dry mouth) (0.2-0.4ml three times daily))
(Ceftriaxone (Appendicitis, Typhoid Fever) (Diarrhea, Rash) 1-2g/day)
(Entecavir (Hepatitis B) (Headache, Fatigue) 0.5mg/day)
(Tamsulosin (Kidney Stones) (Dizziness, Headache) 0.4mg/day)
(Erythropoietin (Chronic Kidney Disease) (High blood pressure, Joint pain) (Varies by patient))
(Nitrofurantoin (Urinary Tract Infection) (Nausea, Diarrhea) (50-100mg every 6 hours))
((Ferrous sulfate) Anemia (Constipation, Stomach upset) 325mg/day)
(Levothyroxine Hypothyroidism (Palpitations, Insomnia) 50-200mcg/day)
(Methimazole Hyperthyroidism (Rash, Joint pain) 10-30mg/day)
(Hydroxychloroquine (Rheumatoid Arthritis, Lupus) (Eye toxicity, Nausea) 200-400mg/day)
(Ibuprofen (Osteoarthritis, Pain relief) (Stomach pain, Nausea) 200-800mg)
(Colchicine Gout (Diarrhea, Nausea) 0.6mg/day)
(Methotrexate (Psoriasis, Rheumatoid Arthritis) (Nausea, Mouth sores) 7.5-25mg/week)
(Acyclovir (Chickenpox, Herpes) (Nausea, Diarrhea) (800mg five times daily))
((Vitamin A) Measles (Headache, Dizziness) (200,000 IU for 2 days))
(Ibuprofen Mumps (Stomach pain, Nausea) 200-800mg)
(Acetaminophen (Rubella, Fever, Pain relief) (Liver damage at high dose) 500-1000mg)
(Acetaminophen (Dengue Fever) (Liver damage at high dose) 500-1000mg)
(Chloroquine Malaria (Nausea, Headache) 500mg/week)
(Dapsone Leprosy (Hemolysis, Methemoglobinemia) 50-100mg/day)
((Tetanus immune globulin) Tetanus (Allergic reaction) (250-500 IU once))
((Oral rehydration salts) Cholera (Rare adverse effects) (As per guidelines))
((Rabies vaccine) Rabies (Injection site pain, Fever) (Varies by protocol))
((Antiretroviral therapy) HIV/AIDS (Nausea, Fatigue, Diarrhea) (Varies by regimen))

